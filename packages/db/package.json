{
  "name": "@babascamera/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./money": "./src/money.ts",
    "./schema": "./src/schema/index.ts",
    "./storage": "./src/storage/index.ts",
    "./auth": "./src/auth.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint src scripts tests --max-warnings=0",
    "test": "bun test && bun run db:validate",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "bun scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:validate": "bun scripts/validate-migration.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.1",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@babascamera/config": "workspace:*",
    "@electric-sql/pglite": "0.5.4",
    "@types/bun": "1.3.14",
    "@types/node": "24.10.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}

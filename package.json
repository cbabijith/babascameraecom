{
  "name": "babas-camera-ecommerce",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14",
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@babascamera/web",
    "dev:admin": "turbo run dev --filter=@babascamera/admin",
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "typecheck": "bun run type-check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "bun run --cwd tests/e2e e2e",
    "test:e2e:chromium": "bun run --cwd tests/e2e e2e --project=chromium",
    "test:e2e:headed": "bun run --cwd tests/e2e e2e:headed",
    "check": "bun run type-check && bun run lint && bun run test && bun run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:check": "bun run --cwd packages/db db:check",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:studio": "bun run --cwd packages/db db:studio",
    "db:validate": "bun run --cwd packages/db db:validate",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop --no-backup"
  },
  "devDependencies": {
    "@babascamera/config": "workspace:*",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "supabase": "2.110.0",
    "turbo": "2.10.7",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "@tailwindcss/postcss": "4.3.3",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "next": "15.5.22",
    "postgres": "3.4.9",
    "tailwindcss": "4.3.3",
    "turbo": "2.10.7",
    "typescript": "5.9.3"
  }
}

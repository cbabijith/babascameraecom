{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run --cwd apps/web build && echo build-cache-bust-20260829",
    "watchPatterns": [
      "/apps/web/**",
      "/packages/config/**",
      "/packages/db/**",
      "/packages/ui/**",
      "/package.json",
      "/bun.lock",
      "/turbo.json"
    ]
  },
  "deploy": {
    "startCommand": "bun run --cwd apps/web start",
    "healthcheckPath": "/api/health/live",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "sleepApplication": true
  }
}

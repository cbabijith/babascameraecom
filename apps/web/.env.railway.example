# Public application URL. Replace this after Railway generates a domain or
# after attaching the final custom domain. Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=https://shop.example.com

# better-auth session signing; BETTER_AUTH_URL should match NEXT_PUBLIC_SITE_URL.
BETTER_AUTH_SECRET=GENERATE_A_LONG_RANDOM_SECRET
BETTER_AUTH_URL=https://shop.example.com

# PostgreSQL connection. Railway databases must use TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/railway?sslmode=require

# Razorpay browser-safe key and server-only credentials
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# Server-only token protecting POST /api/internal/jobs
CRON_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Transactional email
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=Baba's Camera <orders@example.com>

# Tigris (S3-compatible) object storage for product media
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET=REPLACE_ME
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
NEXT_PUBLIC_S3_PUBLIC_URL=https://shop.example.com

# Store contact details
NEXT_PUBLIC_STORE_EMAIL=info@example.com
NEXT_PUBLIC_STORE_PHONE=+910000000000
NEXT_PUBLIC_STORE_WHATSAPP=910000000000

# Optional integration adapter overrides
PAYMENT_ADAPTER=razorpay
EMAIL_ADAPTER=resend

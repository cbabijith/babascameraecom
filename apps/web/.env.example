# Browser-safe values
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_STORE_EMAIL=photostore@babas.in
NEXT_PUBLIC_STORE_PHONE=+91 471 257 2111
NEXT_PUBLIC_STORE_ADDRESS=

# Server-only database and integration values
DATABASE_URL=
# better-auth session signing; BETTER_AUTH_URL should match NEXT_PUBLIC_SITE_URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional internal origin for server-to-server storefront API calls.
# Set this to the deployed storefront origin when it differs from NEXT_PUBLIC_SITE_URL.
STOREFRONT_INTERNAL_ORIGIN=
# Optional comma-separated HTTPS media host allowlist.
STOREFRONT_MEDIA_HOSTS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@example.com

# Tigris (S3-compatible) object storage for product media.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_S3_PUBLIC_URL=

# Explicit non-production adapters. Never enable in production.
PAYMENT_ADAPTER=razorpay
EMAIL_ADAPTER=resend

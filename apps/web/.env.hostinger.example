# Public storefront configuration. These values are included in the browser build.
NEXT_PUBLIC_SITE_URL=https://www.babascamera.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_or_test_key_id
NEXT_PUBLIC_STORE_EMAIL=photostore@babas.in
NEXT_PUBLIC_STORE_PHONE=+91 471 257 2111
NEXT_PUBLIC_STORE_ADDRESS=YOUR_PUBLIC_STORE_ADDRESS

# Server-only values. Add these in Hostinger hPanel; never prefix them with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET
CRON_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=orders@babascamera.com

# Production adapters.
PAYMENT_ADAPTER=razorpay
EMAIL_ADAPTER=resend

# Browser-safe Supabase connection details.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Drizzle connection. Prefer the Supabase session pooler for runtime.
DATABASE_URL=

# Public storefront URL used for preview links.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Server-only payment credentials. Never prefix these with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Product uploads use the signed-in administrator session and product-images
# storage RLS. Never put a Supabase service-role key in this application.

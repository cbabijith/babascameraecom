# Server-only Drizzle connection. Remote databases must use TLS.
DATABASE_URL=

# better-auth admin panel session signing.
BETTER_AUTH_SECRET=
# Canonical admin origin (used for cookies and OAuth redirects).
BETTER_AUTH_URL=http://localhost:3001

# Public storefront URL used for preview links.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Server-only payment credentials. Never prefix these with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Tigris (S3-compatible) object storage for product and banner media.
# Product uploads use the signed-in administrator session and the app's
# media proxy; keep these credentials server-only.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_S3_PUBLIC_URL=

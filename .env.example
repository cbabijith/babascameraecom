# PostgreSQL / Drizzle
# This project uses the project-qualified Supabase transaction-mode pooler on
# port 6543 for IPv4-only access. The migration client keeps max=1 and
# prepare=false for pooler compatibility.
DATABASE_URL=
# Required by db:migrate for hosted Supabase target verification. This is the
# non-secret 20-character project reference, not a key.
SUPABASE_PROJECT_REF=

# Supabase server values
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase browser-safe values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# New Supabase projects may label the browser key "publishable". The apps accept
# this alias as well; set either it or NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@babascamera.com

# Public application URLs
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Compatibility names consumed by metadata, auth redirects, and preview links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Server-only scheduled job authentication.
CRON_SECRET=

# Integration adapters. Production must use razorpay/resend. Deterministic
# adapters are accepted only in non-production automated tests.
PAYMENT_ADAPTER=razorpay
EMAIL_ADAPTER=resend

# Public product media bucket created by the Drizzle migration.
PRODUCT_IMAGES_BUCKET=product-images

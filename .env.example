# PostgreSQL / Drizzle. Remote databases must use TLS; local development can
# omit sslmode. The migration client keeps max=1 and prepare=false.
DATABASE_URL=

# better-auth (shared by web + admin against the same database)
BETTER_AUTH_SECRET=
# Canonical origin of the app this config deploys with (web or admin).
BETTER_AUTH_URL=http://localhost:3000

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Google OAuth (storefront only; optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@babascamera.com

# Tigris (S3-compatible) object storage for product and banner media.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Base URL each app uses for its own /api/media proxy of the private bucket.
NEXT_PUBLIC_S3_PUBLIC_URL=

# Public application URLs
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Compatibility names consumed by metadata, auth redirects, and preview links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Server-only scheduled job authentication.
CRON_SECRET=

# Integration adapters. Production must use razorpay/resend. Deterministic
# adapters are accepted only in non-production automated tests.
PAYMENT_ADAPTER=razorpay
EMAIL_ADAPTER=resend

# Public product media bucket name.
PRODUCT_IMAGES_BUCKET=product-images
